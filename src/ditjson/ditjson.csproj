<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>ditjson</AssemblyTitle>
    <Company>Info-Assure, Zafer Balkan</Company>
    <Product>ditjson</Product>
    <Copyright>Copyright © Info-Assure 2015, © Zafer Balkan 2026</Copyright>
    <!-- JSON contracts are provided by StructuredOutputJsonContext. Keep the
         reflection fallback disabled so published builds cannot accidentally
         depend on runtime metadata. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Database.ManagedEsent" Version="3.2.0" />
    <InternalsVisibleTo Include="ditjson.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Enable trimming and NativeAOT; Windows toolchain selection is handled in Directory.Build.targets or CI. -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
